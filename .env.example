# Copy this file to backend/.env and fill in your keys

# API Keys
ANTHROPIC_API_KEY=sk-ant-...
ELEVENLABS_API_KEY=...
DEEPGRAM_API_KEY=...

# Local storage (create these directories first)
DATABASE_PATH=/absolute/path/to/interview/db/interview.db
AUDIO_STORAGE_PATH=/absolute/path/to/interview/audio
